PORT=3000
# In-memory example routes are disabled unless BOTH values below are set.
# Never expose development mode to untrusted networks.
NODE_ENV=development
ENABLE_DEMO_CRUD=false
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/restaurant
DATABASE_SSL=false
# Azure PostgreSQL: postgresql://USER:URL_ENCODED_PASSWORD@SERVER.postgres.database.azure.com:5432/restaurant
# Set DATABASE_SSL=true for Azure; do not append sslmode to DATABASE_URL.
# Production: DATABASE_SSL=true. Optional custom certificate authority PEM:
# DATABASE_SSL_CA=
DATABASE_POOL_SIZE=10
REDIS_URL=redis://localhost:6379
KBANK_WEBHOOK_TOKEN=replace-with-kbank-adapter-secret

# Azure Event Hubs Kafka endpoint or another managed Kafka-compatible service.
KAFKA_BROKERS=
KAFKA_SSL=true
KAFKA_SASL_USERNAME=
KAFKA_SASL_PASSWORD=
KAFKA_ORDER_TOPIC=orders.v1

# Optional production provisioning inputs, parsed by scripts/prepare-production.mjs.
# Keep real values in ignored .env.local. These do not change runtime settings above.
PRODUCTION_AZURE_SUBSCRIPTION_ID=
PRODUCTION_AZURE_TENANT_ID=
PRODUCTION_AZURE_LOCATION=southeastasia
PRODUCTION_AZURE_RESOURCE_GROUP=rg-jaj-prod-sea
PRODUCTION_AZURE_PREFIX=jaj-prod-sea
PRODUCTION_AZURE_ACR_NAME=
PRODUCTION_AZURE_KEY_VAULT=
PRODUCTION_AZURE_PG_SERVER=
PRODUCTION_AZURE_PG_SKU=Standard_D2s_v3
PRODUCTION_AZURE_EVENTHUB_NAMESPACE=
PRODUCTION_AZURE_CONTAINER_APP=jaj-api-prod-sea
PRODUCTION_AZURE_CONTAINER_NAME=api
PRODUCTION_AZURE_CLIENT_ID=
PRODUCTION_AZURE_PIPELINE_PRINCIPAL_ID=
PRODUCTION_ALERT_EMAIL=
PRODUCTION_CUSTOM_API_DOMAIN=
PRODUCTION_IMAGE_DIGEST=
PRODUCTION_PG_ADMIN_PASSWORD=
PRODUCTION_PG_APP_PASSWORD=
PRODUCTION_KBANK_WEBHOOK_TOKEN=
PRODUCTION_AZURE_DEPLOY_PRODUCTION=false
