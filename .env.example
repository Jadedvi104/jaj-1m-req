PORT=3000
# In-memory example routes are disabled unless BOTH values below are set.
# Never expose development mode to untrusted networks.
NODE_ENV=development
ENABLE_DEMO_CRUD=false
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/restaurant
DATABASE_SSL=false
# Azure PostgreSQL: postgresql://USER:URL_ENCODED_PASSWORD@SERVER.postgres.database.azure.com:5432/restaurant
# Set DATABASE_SSL=true for Azure; do not append sslmode to DATABASE_URL.
# Production: DATABASE_SSL=true. Optional custom certificate authority PEM:
# DATABASE_SSL_CA=
DATABASE_POOL_SIZE=10
REDIS_URL=redis://localhost:6379
KBANK_WEBHOOK_TOKEN=replace-with-kbank-adapter-secret

# Azure Event Hubs Kafka endpoint or another managed Kafka-compatible service.
KAFKA_BROKERS=
KAFKA_SSL=true
KAFKA_SASL_USERNAME=
KAFKA_SASL_PASSWORD=
KAFKA_ORDER_TOPIC=orders.v1
